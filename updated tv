      </section>
    </main>

    <footer>
      <span>© <span id="year"></span> SCRONIC TV</span>
      <span>MADE FOR THE MOMENTS.</span>
      <a href="https://www.twitch.tv/7Scronic" target="_blank" rel="noopener">@7SCRONIC ON TWITCH ↗</a>
    </footer>
  </div>
  <script>
    const streamgoodUrl = "https://streamgood.gg/clips/player?mode=random&current_game=false&info=false&volume=50&max_length=60&filter_long_videos=false&show_timer=false&recent_clips=365&channel=7scronic";
