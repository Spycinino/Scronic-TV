<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#09090d">
  <meta name="description" content="SCRONIC TV — random clips, live streams, and moments from 7Scronic.">
  <title>SCRONIC TV — 7Scronic</title>
  <style>
    :root { --bg:#09090d; --panel:#111118; --line:#292936; --text:#f6f5fb; --muted:#a6a5b5; --purple:#a855f7; --pink:#ec4899; }
    * { box-sizing:border-box; }
    html { color-scheme:dark; scroll-behavior:smooth; }
    body { margin:0; min-height:100vh; background:
      radial-gradient(ellipse at 80% 0%, rgba(168,85,247,.17), transparent 38%),
      radial-gradient(ellipse at 0% 35%, rgba(236,72,153,.08), transparent 32%), var(--bg);
      color:var(--text); font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif; }
    a { color:inherit; }
    .wrap { width:min(1080px, calc(100% - 32px)); margin:auto; }
    header { display:flex; align-items:center; justify-content:space-between; gap:16px; padding:24px 0; }
    .brand { display:flex; align-items:center; gap:12px; text-decoration:none; font-weight:950; letter-spacing:.09em; }
    .mark { display:grid; place-items:center; width:42px; height:42px; border:1px solid #b77aff; border-radius:12px; background:linear-gradient(145deg,#a855f7,#5415a5); box-shadow:0 0 30px #a855f733; font-size:20px; }
    .brand small { display:block; margin-top:2px; color:var(--muted); font-size:10px; letter-spacing:.24em; }
    .live-pill { display:inline-flex; align-items:center; gap:8px; border:1px solid #3a2634; background:#1a1019; padding:8px 12px; border-radius:999px; font-size:11px; font-weight:800; letter-spacing:.12em; }
    .dot { width:7px; height:7px; background:#fb477c; border-radius:50%; box-shadow:0 0 12px #fb477c; }
    .hero { padding:36px 0 24px; }
    .eyebrow { color:#d6b5ff; font-size:11px; font-weight:850; letter-spacing:.24em; text-transform:uppercase; }
    h1 { font-size:clamp(42px,8vw,84px); line-height:.94; letter-spacing:-.065em; margin:14px 0; font-weight:1000; }
    h1 span { color:transparent; -webkit-text-stroke:1px #c084fc; }
    .intro { max-width:590px; color:var(--muted); line-height:1.7; font-size:15px; }
    .player-shell { margin:28px 0 18px; padding:10px; background:linear-gradient(135deg,#a855f755,#ec489933 55%,#28283b); border:1px solid #4b3263; border-radius:22px; box-shadow:0 24px 90px #0008; }
    .player-top { display:flex; justify-content:space-between; align-items:center; gap:12px; padding:6px 8px 12px; color:#d6d4e3; font-size:11px; font-weight:800; letter-spacing:.12em; text-transform:uppercase; }
    .player { position:relative; overflow:hidden; background:#050507; border-radius:14px; aspect-ratio:16/9; min-height:240px; display:grid; place-items:center; }
    iframe { position:absolute; inset:0; width:100%; height:100%; border:0; background:#050507; }
    .fallback { max-width:470px; text-align:center; padding:28px; position:relative; z-index:1; }
    .play { width:70px; height:70px; display:grid; place-items:center; border-radius:50%; margin:0 auto 18px; background:linear-gradient(145deg,var(--purple),#6d28d9); box-shadow:0 0 40px #a855f766; font-size:25px; }
    .fallback h2 { margin:0 0 8px; font-size:24px; }
    .fallback p { color:var(--muted); line-height:1.6; font-size:13px; }
    .actions { display:flex; flex-wrap:wrap; gap:10px; margin:18px 0 42px; }
    .btn { display:inline-flex; align-items:center; justify-content:center; gap:9px; min-height:46px; padding:0 17px; border-radius:12px; text-decoration:none; font-weight:850; font-size:13px; border:1px solid var(--line); transition:transform .18s,border-color .18s; }
    .btn:hover { transform:translateY(-2px); border-color:#a855f7; }
    .primary { border:0; background:linear-gradient(110deg,#9333ea,#c026d3); color:white; box-shadow:0 8px 30px #9333ea33; }
    .secondary { background:#15151e; }
    .grid { display:grid; grid-template-columns:repeat(3,1fr); gap:12px; margin:0 0 58px; }
    .tile { padding:20px; border:1px solid var(--line); background:linear-gradient(145deg,#15151e,#0e0e14); border-radius:16px; }
    .tile .icon { font-size:22px; margin-bottom:14px; }
    .tile h3 { margin:0 0 7px; font-size:14px; }
    .tile p { margin:0; color:var(--muted); font-size:12px; line-height:1.6; }
    footer { display:flex; justify-content:space-between; gap:16px; flex-wrap:wrap; padding:22px 0 30px; border-top:1px solid var(--line); color:#777687; font-size:11px; letter-spacing:.08em; }
    footer a { text-decoration:none; color:#d6b5ff; }
    .notice { color:#858394; font-size:11px; line-height:1.6; margin:-28px 0 42px; }
    @media(max-width:700px) { header { padding:17px 0; } .hero { padding-top:28px; } .grid { grid-template-columns:1fr; } .tile { display:flex; gap:14px; align-items:flex-start; } .tile .icon { margin:0; } .player-shell { padding:6px; border-radius:16px; } .player { min-height:220px; } .live-pill { font-size:9px; } }
  </style>
</head>
<body>
  <div class="wrap">
